{
  "name": "va-dispatch",
  "private": true,
  "version": "0.1.0",
  "description": "Multi-tenant Virtual Airline Live Dispatch & ACARS tool",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @va-dispatch/api --filter @va-dispatch/web dev",
    "dev:api": "pnpm --filter @va-dispatch/api dev",
    "dev:web": "pnpm --filter @va-dispatch/web dev",
    "build": "pnpm -r --if-present build",
    "build:api": "pnpm --filter @va-dispatch/api build",
    "build:web": "pnpm --filter @va-dispatch/web build",
    "test": "pnpm -r --if-present test",
    "test:api": "pnpm --filter @va-dispatch/api test",
    "test:web": "pnpm --filter @va-dispatch/web test",
    "lint": "pnpm -r --if-present lint",
    "format:check": "prettier --check package.json pnpm-workspace.yaml vercel.ts README.md docs .github/workflows apps/web",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:generate": "pnpm --filter @va-dispatch/api db:generate",
    "db:migrate": "pnpm --filter @va-dispatch/api db:migrate",
    "db:push": "pnpm --filter @va-dispatch/api db:push",
    "db:studio": "pnpm --filter @va-dispatch/api db:studio"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@vercel/config": "^0.5.6",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
