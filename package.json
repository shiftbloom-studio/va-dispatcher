{
  "name": "va-dispatch",
  "private": true,
  "version": "0.1.0",
  "description": "Multi-tenant Virtual Airline Live Dispatch & ACARS tool",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/shiftbloom-studio/va-dispatcher",
  "repository": {
    "type": "git",
    "url": "https://github.com/shiftbloom-studio/va-dispatcher.git"
  },
  "bugs": {
    "url": "https://github.com/shiftbloom-studio/va-dispatcher/issues"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @va-dispatch/api --filter @va-dispatch/web dev",
    "dev:api": "pnpm --filter @va-dispatch/api dev",
    "dev:web": "pnpm --filter @va-dispatch/web dev",
    "build": "pnpm -r --if-present build",
    "build:api": "pnpm --filter @va-dispatch/api build",
    "build:web": "pnpm --filter @va-dispatch/web build",
    "test": "pnpm -r --if-present test",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "test:api": "pnpm --filter @va-dispatch/api test",
    "test:web": "pnpm --filter @va-dispatch/web test",
    "lint": "pnpm -r --if-present lint",
    "format:check": "prettier --check package.json pnpm-workspace.yaml vercel.ts README.md CONTRIBUTING.md CODE_OF_CONDUCT.md SECURITY.md SUPPORT.md docs .github apps packages",
    "security:audit": "pnpm audit --audit-level high",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:generate": "pnpm --filter @va-dispatch/api db:generate",
    "db:migrate": "pnpm --filter @va-dispatch/api db:migrate",
    "db:push": "pnpm --filter @va-dispatch/api db:push",
    "db:studio": "pnpm --filter @va-dispatch/api db:studio"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@vitest/coverage-istanbul": "5.0.0-rc.1",
    "prettier": "3.9.6",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript7": "npm:typescript@7.0.2"
  }
}
