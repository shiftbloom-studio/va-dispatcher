# Local development settings for the API Worker. Copy the values you need into
# apps/api/.dev.vars (read by `wrangler dev`); production values are set as
# Worker variables and secrets, see docs/cloudflare-deployment.md.
#
# The D1 database and R2 logo bucket are bindings, not variables. Locally
# `wrangler dev` simulates both; apply the schema once with
# `pnpm db:migrate:local`.

# Auth (Clerk). Leave unset with AUTH_DEV_BYPASS=true for local-only work.
AUTH_DEV_BYPASS=true
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# ACARS: mock locally, hoppie in production.
ACARS_PROVIDER=mock

# 32-byte key, base64-encoded: openssl rand -base64 32
TENANT_SECRETS_KEY=
AVIATION_WEATHER_API_ORIGIN=https://aviationweather.gov/api/data
AVIATION_WEATHER_USER_AGENT=va-dispatch/0.1 (+https://github.com/shiftbloom-studio/va-dispatcher)
# Local/test default only. Production must use a unique value. Scheduled jobs
# run from the Worker's cron triggers; this only guards the manual endpoints.
CRON_SECRET=dev-cron-secret-change-me

# SimBrief Dispatch Redirect integration (request a key from SimBrief first)
# SIMBRIEF_API_KEY=...
# SIMBRIEF_CALLBACK_URL=http://localhost:3000/api/v1/simbrief/callback

# Navigraph OAuth account authentication (credentials are issued by Navigraph).
# The registered production redirect URI must exactly match
# https://<your-host>/api/v1/simbrief/oauth/callback
# NAVIGRAPH_CLIENT_ID=...
# NAVIGRAPH_CLIENT_SECRET=...
# NAVIGRAPH_REDIRECT_URI=http://localhost:3000/api/v1/simbrief/oauth/callback

# Optional bootstrap
SEED_DEMO_DATA=false
VSAS_CLERK_ORG_ID=org_...
