# App
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Database (Neon Postgres)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Auth (Clerk)
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# ACARS
ACARS_PROVIDER=mock

# Secrets
# 32-byte key, base64-encoded: openssl rand -base64 32
TENANT_SECRETS_KEY=
BLOB_READ_WRITE_TOKEN=
AVIATION_WEATHER_API_ORIGIN=https://aviationweather.gov/api/data
AVIATION_WEATHER_USER_AGENT=va-dispatch/0.1 (+https://github.com/shiftbloom-studio/va-dispatcher)
CRON_SECRET=dev-cron-secret-change-me

# SimBrief Dispatch Redirect integration (request a key from SimBrief first)
# SIMBRIEF_API_KEY=...
# SIMBRIEF_CALLBACK_URL=http://localhost:3001/api/v1/simbrief/callback

# Navigraph OAuth account authentication (credentials are issued by Navigraph)
# Registered production redirect URI (exact match):
# https://www.va-dispatcher.world/api/v1/simbrief/oauth/callback
# NAVIGRAPH_CLIENT_ID=...
# NAVIGRAPH_CLIENT_SECRET=...
# NAVIGRAPH_REDIRECT_URI=http://localhost:3001/api/v1/simbrief/oauth/callback

# Optional bootstrap
SEED_DEMO_DATA=false
VSAS_CLERK_ORG_ID=org_...
