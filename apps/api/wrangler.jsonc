// Template. Values written as <PLACEHOLDER> are filled from environment variables by
// scripts/render-config.mjs, which writes wrangler.deploy.jsonc (not committed).
// Top-level settings are for local development (`pnpm dev`); deploys use
// `--env production`. In production the API Worker claims <VA_HOSTNAME>/api/*
// with a zone route, so web and API share one origin. Server components in the
// web Worker reach the API through a service binding instead.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "va-dispatch-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  // nodejs_compat also populates process.env from vars and secrets.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "va-dispatch",
      "database_id": "local",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    { "binding": "TENANT_LOGOS", "bucket_name": "va-dispatch-tenant-logos" },
  ],
  "vars": {
    "NODE_ENV": "development",
    "APP_ORIGIN": "http://localhost:3000",
    "CORS_ORIGIN": "http://localhost:3000",
    "ACARS_PROVIDER": "mock",
  },
  "env": {
    "production": {
      "name": "va-dispatch-api",
      // Takes precedence over the web Worker's custom domain for /api/*.
      "routes": [
        { "pattern": "<VA_HOSTNAME>/api/*", "zone_name": "<VA_ZONE_NAME>" },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "va-dispatch",
          "database_id": "<VA_D1_DATABASE_ID>",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "TENANT_LOGOS",
          "bucket_name": "va-dispatch-tenant-logos",
        },
      ],
      // Keep in sync with CRON_ACARS_POLL and CRON_PRIVACY_LIFECYCLE in src/worker.ts.
      "triggers": { "crons": ["* * * * *", "0 * * * *"] },
      "vars": {
        "NODE_ENV": "production",
        "APP_ENV": "production",
        "APP_ORIGIN": "https://<VA_HOSTNAME>",
        "CORS_ORIGIN": "https://<VA_HOSTNAME>",
        "ACARS_PROVIDER": "hoppie",
        "CLERK_PUBLISHABLE_KEY": "<CLERK_PUBLISHABLE_KEY>",
        "SIMBRIEF_CALLBACK_URL": "https://<VA_HOSTNAME>/api/v1/simbrief/callback",
        "NAVIGRAPH_REDIRECT_URI": "https://<VA_HOSTNAME>/api/v1/simbrief/oauth/callback",
        "VSAS_CLERK_ORG_ID": "<VSAS_CLERK_ORG_ID>",
      },
      // Secrets (wrangler secret put --env production): CLERK_SECRET_KEY,
      // TENANT_SECRETS_KEY, CRON_SECRET, SIMBRIEF_API_KEY, NAVIGRAPH_CLIENT_ID,
      // NAVIGRAPH_CLIENT_SECRET.
    },
  },
}
