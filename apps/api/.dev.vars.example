# Local variables for `wrangler dev` (pnpm dev:api). Copy to .dev.vars, which
# is not committed. wrangler.jsonc already sets NODE_ENV, CORS_ORIGIN,
# APP_ORIGIN, and ACARS_PROVIDER=mock for local development.

# Local development without Clerk: X-Dev-* headers identify the caller.
AUTH_DEV_BYPASS=true
VSAS_CLERK_ORG_ID=org_vsas_dev

# Real Clerk mode (set AUTH_DEV_BYPASS=false).
# CLERK_SECRET_KEY=sk_test_...
# CLERK_PUBLISHABLE_KEY=pk_test_...

# 32 random bytes, base64 (openssl rand -base64 32). Never reuse production keys.
# TENANT_SECRETS_KEY=
# Local default only. Production uses a unique secret.
# CRON_SECRET=dev-cron-secret-change-me

# SimBrief Dispatch Redirect (request a key from SimBrief first).
# SIMBRIEF_API_KEY=...
# SIMBRIEF_CALLBACK_URL=http://localhost:3001/api/v1/simbrief/callback

# Navigraph OAuth. Production registers https://<host>/api/v1/simbrief/oauth/callback.
# NAVIGRAPH_CLIENT_ID=...
# NAVIGRAPH_CLIENT_SECRET=...
# NAVIGRAPH_REDIRECT_URI=http://localhost:3001/api/v1/simbrief/oauth/callback
