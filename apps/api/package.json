{
  "name": "@va-dispatch/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 3001",
    "db:migrate:local": "wrangler d1 migrations apply va-dispatch --local",
    "db:generate": "drizzle-kit generate && node scripts/sync-d1-migrations.mjs",
    "build": "node ./node_modules/typescript7/bin/tsc -p tsconfig.build.json",
    "config": "node scripts/render-config.mjs",
    "deploy": "node scripts/render-config.mjs && wrangler d1 migrations apply va-dispatch --remote --env production -c wrangler.deploy.jsonc && wrangler deploy --env production -c wrangler.deploy.jsonc",
    "check:deploy": "node scripts/render-config.mjs && wrangler deploy --env production -c wrangler.deploy.jsonc --dry-run --outdir .wrangler/dry-run",
    "typecheck": "node ./node_modules/typescript7/bin/tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.1",
    "drizzle-orm": "1.0.0-rc.6",
    "hono": "4.13.21",
    "jose": "6.2.18",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261124.1",
    "@hono/node-server": "2.1.11",
    "@types/node": "26.6.6",
    "drizzle-kit": "1.0.0-rc.6",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript7": "npm:typescript@7.0.2",
    "vitest": "5.1.1",
    "wrangler": "4.168.0"
  },
  "license": "AGPL-3.0-or-later"
}
