{
  "name": "@va-dispatch/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/local.ts",
    "build": "node ./node_modules/typescript7/bin/tsc -p tsconfig.build.json",
    "start": "node dist/local.js",
    "typecheck": "node ./node_modules/typescript7/bin/tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:postgres": "vitest run src/db/repositories/memberships.postgres.test.ts src/db/repositories/simbrief.postgres.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check && node scripts/check-migration-drift.mjs",
    "db:migrate": "node scripts/run-migrations.mjs",
    "db:adopt:pr29": "node scripts/adopt-pr29-baseline.mjs",
    "db:signature": "node scripts/print-schema-signature.mjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@clerk/backend": "3.16.4",
    "@hono/node-server": "2.1.0",
    "@hono/zod-validator": "0.9.0",
    "@neondatabase/serverless": "1.1.0",
    "@vercel/blob": "2.8.0",
    "botid": "1.5.11",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "4.13.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.21.0",
    "drizzle-kit": "1.0.0-rc.4",
    "pg": "8.23.0",
    "postgres": "3.4.7",
    "tsx": "4.23.12",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript7": "npm:typescript@7.0.2",
    "vitest": "5.0.0-rc.1"
  }
}
