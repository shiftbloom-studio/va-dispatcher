NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Server-side API origin. Vercel injects API_INTERNAL_URL through the service binding.
API_INTERNAL_URL=http://localhost:3001
# Same-origin /api/* rewrite target in local development. In a two-project
# fallback deployment, set this to the public URL of the API Vercel project.
API_ORIGIN=http://localhost:3001

# Public corresponding-source URL shown in the application legal notice.
# Hosted forks must point this at the source for the deployed version.
NEXT_PUBLIC_SOURCE_URL=https://github.com/shiftbloom-studio/va-dispatcher

# Test-only. The application rejects this setting in production.
E2E_AUTH_BYPASS=false
