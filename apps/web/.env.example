NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Local development only. Server components and the same-origin /api/* rewrite
# reach the API Worker running under `wrangler dev`. On Cloudflare the web
# Worker uses its API service binding instead; leave these unset there.
API_ORIGIN=http://localhost:3001

# Public corresponding-source URL shown in the application legal notice.
# Hosted forks must point this at the source for the deployed version.
NEXT_PUBLIC_SOURCE_URL=https://github.com/shiftbloom-studio/va-dispatcher

# Test-only. The fast browser suite sets route fixtures itself. The integrated
# suite sets this together with a dedicated server authority and disposable DB.
NEXT_PUBLIC_E2E_ROUTE_FIXTURE_MODE=false
NEXT_PUBLIC_E2E_FIXTURE_MODE=false

# Public legal identity. These values are rendered server-side on /imprint,
# /impressum, /privacy and /datenschutz. Separate postal-address lines with |.
LEGAL_OPERATOR_NAME=
# Optional plain-language context, for example "Private individual operating
# the open-source project Example Studio".
LEGAL_OPERATOR_DESCRIPTION=
LEGAL_OPERATOR_ADDRESS=
LEGAL_OPERATOR_EMAIL=
LEGAL_PRIVACY_EMAIL=
LEGAL_OPERATOR_PHONE=
LEGAL_REPRESENTATIVE=
# Configure register name and number together when the operator is registered.
LEGAL_REGISTER_NAME=
LEGAL_REGISTER_NUMBER=
LEGAL_VAT_ID=
# Configure the responsible person's name and complete address together when
# Section 18(2) MStV applies.
LEGAL_EDITORIALLY_RESPONSIBLE_NAME=
LEGAL_EDITORIALLY_RESPONSIBLE_ADDRESS=
LEGAL_SUPERVISORY_AUTHORITY_NAME=
LEGAL_SUPERVISORY_AUTHORITY_URL=
