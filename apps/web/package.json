{
  "name": "@va-dispatch/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Virtual Airline pilot portal and dispatcher suite",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:integrated": "playwright test --config playwright.integrated.config.ts",
    "format:check": "prettier --check . --ignore-path ../../.gitignore"
  },
  "dependencies": {
    "@clerk/nextjs": "7.10.8",
    "@hookform/resolvers": "7.0.9",
    "@tanstack/react-query": "5.108.4",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.1.0",
    "botid": "1.5.13",
    "lucide-react": "1.79.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@va-dispatch/eslint-config": "workspace:*",
    "eslint": "10.15.0",
    "jsdom": "31.0.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
